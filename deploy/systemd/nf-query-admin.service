[Unit]
Description=nf-query administration service
Documentation=file:/opt/nf-query/current/docs/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=nf-query-admin
Group=nf-query-admin
SupplementaryGroups=nf-query-public
WorkingDirectory=/opt/nf-query/current

Environment=NODE_ENV=production
Environment=NFQ_BINDINGS_DB=/var/lib/nf-query/shared/bindings.db
Environment=NFQ_ADMIN_STATE_DB=/var/lib/nf-query/admin/admin-state.db
Environment=NFQ_ORIGIN=https://nf.mystool.me,https://query.baochai.cc
Environment=NFQ_UPSTREAM_BASE_URL=https://temp-email-api.mystool.me
Environment=NFQ_ADMIN_PORT=3790
Environment=NFQ_TRUST_PROXY=1
Environment=ADDRESS_JWT_KEY_FILE=%d/address-jwt-key
Environment=ADMIN_PASSWORD_HASH_FILE=%d/admin-password-hash
Environment=NFQ_PROXY_SECRET_FILE=%d/proxy-auth-secret
EnvironmentFile=-/etc/nf-query/admin.env
LoadCredentialEncrypted=address-jwt-key:/etc/nf-query/credentials/address-jwt-key.cred
LoadCredentialEncrypted=admin-password-hash:/etc/nf-query/credentials/admin-password-hash.cred
LoadCredential=proxy-auth-secret:/etc/nf-query/proxy-auth-secret

ExecStart=/usr/bin/node src/admin-server.js
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=control-group
UMask=0027

RuntimeDirectory=nf-query-admin
RuntimeDirectoryMode=0700
MemoryHigh=230M
MemoryMax=256M
MemorySwapMax=0
TasksMax=128
LimitNOFILE=4096
LimitCORE=0
CoredumpFilter=0

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/nf-query/shared /var/lib/nf-query/admin

[Install]
WantedBy=multi-user.target
