[Unit]
Description=nf-query public mail query service
Documentation=file:/opt/nf-query/current/docs/operations.md
After=network-online.target nf-query-admin.service
Wants=network-online.target

[Service]
Type=exec
User=nf-query-public
Group=nf-query-public
WorkingDirectory=/opt/nf-query/current

Environment=NODE_ENV=production
Environment=NFQ_BINDINGS_DB=/var/lib/nf-query/shared/bindings.db
Environment=NFQ_ORIGIN=https://nf.mystool.me,https://query.baochai.cc
Environment=NFQ_UPSTREAM_BASE_URL=https://temp-email-api.mystool.me
Environment=NFQ_PUBLIC_PORT=3789
Environment=NFQ_TRUST_PROXY=1
Environment=ADDRESS_JWT_KEY_FILE=%d/address-jwt-key
EnvironmentFile=-/etc/nf-query/public.env
LoadCredentialEncrypted=address-jwt-key:/etc/nf-query/credentials/address-jwt-key.cred

ExecStart=/usr/bin/node src/public-server.js
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=control-group
UMask=0027

RuntimeDirectory=nf-query-public
RuntimeDirectoryMode=0750
MemoryHigh=460M
MemoryMax=512M
MemorySwapMax=0
TasksMax=128
LimitNOFILE=4096
LimitCORE=0
CoredumpFilter=0

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# A compromised public process must not connect to Nginx/admin on loopback.
# Nginx binds its public upstream source to 127.0.0.2, which remains allowed.
IPAddressDeny=127.0.0.1 ::1

# The public process has no writable persistent path. The leading '-' lets the
# unit start (and retry) cleanly while the first admin start creates the file.
ReadOnlyPaths=-/var/lib/nf-query/shared/bindings.db

[Install]
WantedBy=multi-user.target
