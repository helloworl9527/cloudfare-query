[Unit]
Description=Create a consistent nf-query bindings backup
Documentation=file:/opt/nf-query/current/docs/operations.md
RequiresMountsFor=/var/lib/nf-query /var/backups/nf-query
After=nf-query-admin.service

[Service]
Type=oneshot
User=nf-query-admin
Group=nf-query-admin
SupplementaryGroups=nf-query-public
UMask=0077
Environment=BINDINGS_DB_PATH=/var/lib/nf-query/shared/bindings.db
Environment=BACKUP_ROOT=/var/backups/nf-query
Environment=BACKUP_WORK_DIR=/run/nf-query-backup
ExecStart=/usr/local/libexec/nf-query/backup-bindings.sh

RuntimeDirectory=nf-query-backup
RuntimeDirectoryMode=0700

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=256M
TimeoutStartSec=20min

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/var/lib/nf-query/shared/bindings.db
ReadWritePaths=/var/backups/nf-query
